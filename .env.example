# Copy to .env and fill in your own values. Never commit/share .env.
# Optional display label; defaults to development.
FINNIE_ENV=learning
# Optional display label; OpenAI is the implemented model client. demo does not disable calls.
FINNIE_PROVIDER=openai
# Optional model setting; must be accessible to your API project and support web search for News.
FINNIE_MODEL=gpt-4o-mini
# Optional embedding model; source/query models must match. Default shown below.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Required for Chat, model answers, embeddings and News; not for local calculators or Knowledge browsing.
OPENAI_API_KEY=

# Optional Alpaca key ID; supply both Alpaca fields for actual IEX data.
APCA_API_KEY_ID=
# Optional Alpaca secret; paired with the key ID. Leave both blank if not using actual market data.
APCA_API_SECRET_KEY=
